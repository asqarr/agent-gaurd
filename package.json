{
  "name": "agentguard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/api",
    "apps/web",
    "apps/demo-store",
    "packages/agentguard-sdk"
  ],
  "scripts": {
    "dev:api": "npm --workspace apps/api run dev",
    "dev:web": "npm --workspace apps/web run dev",
    "build": "npm --workspace apps/web run build",
    "start:api": "npm --workspace apps/api run start",
    "preflight": "node scripts/launch-preflight.mjs",
    "preflight:production": "node scripts/launch-preflight.mjs --production",
    "load:smoke": "node apps/api/scripts/load-smoke.mjs",
    "test:api": "npm --workspace apps/api run test",
    "test:integration": "npm --workspace apps/api run test:integration",
    "test:runtime-gateway": "npm --workspace apps/api run test:runtime-gateway",
    "test:auth-subscription": "npm --workspace apps/api run test:auth-subscription",
    "test:activity-stream": "node --test apps/api/test/activity-stream.integration.test.mjs",
    "test:security-boundaries": "npm --workspace apps/api run test:security-boundaries",
    "test:billing-business": "npm --workspace apps/api run test:billing-business",
    "test:queue-integration": "npm --workspace apps/api run test:queue-integration",
    "growth:report": "node apps/api/scripts/growth-report.mjs",
    "growth:mark-pilot": "node apps/api/scripts/mark-pilot.mjs",
    "test:sdk": "node --test packages/agentguard-sdk/test/sdk.test.mjs",
    "test:demo-store": "node --test apps/demo-store/test/demo-store.integration.test.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "dotenv": "^18.0.5",
    "express": "^5.2.1"
  }
}
