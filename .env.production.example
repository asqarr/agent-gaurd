NODE_ENV=production

# Public URL served by the web container / reverse proxy.
DOMAIN=app.example.com
ACME_EMAIL=ops@example.com
WEB_ORIGIN=https://app.example.com
VITE_SITE_URL=https://app.example.com
HTTP_PORT=80
HTTPS_PORT=443
TRUST_PROXY=2

POSTGRES_USER=agentguard
POSTGRES_PASSWORD=replace_with_a_long_random_password
POSTGRES_DB=agentguard
DATABASE_URL=postgresql://agentguard:replace_with_a_long_random_password@postgres:5432/agentguard

# Use at least 32 random characters. Do not reuse either secret.
JWT_SECRET=replace_with_at_least_32_random_characters
AGENT_SECRET=replace_with_at_least_32_random_characters
AUTH_COOKIE=__Host-agentguard_session

AGENT_REQUEST_TIMEOUT_MS=30000
AGENT_MAX_RESPONSE_BYTES=1048576
SCAN_WORKER_INTERVAL_MS=1000
SCAN_MAX_ATTEMPTS=3
SCAN_JOB_LEASE_MS=300000
SCAN_RETRY_BASE_MS=2000
RETENTION_WORKER_INTERVAL_MS=3600000
BILLING_RECONCILIATION_INTERVAL_MS=30000
BILLING_RECONCILIATION_BATCH_SIZE=20
SENTINEL_WORKER_INTERVAL_MS=60000
INCIDENT_WORKER_INTERVAL_MS=2000
AUTH_RATE_LIMIT_WINDOW_MS=600000
AUTH_RATE_LIMIT_MAX=30
RUNTIME_RATE_LIMIT_WINDOW_MS=60000
RUNTIME_RATE_LIMIT_MAX=120
RUNTIME_APPROVAL_TTL_MS=30000
RUNTIME_CONTEXT_CLOCK_SKEW_MS=300000
# Temporary portfolio launch mode. Set true after AUTH_EMAIL_WEBHOOK_URL is configured.
REQUIRE_EMAIL_VERIFICATION=false
SCAN_RATE_LIMIT_WINDOW_MS=60000
SCAN_RATE_LIMIT_MAX=10
WEBHOOK_RATE_LIMIT_WINDOW_MS=60000
WEBHOOK_RATE_LIMIT_MAX=10

# Direct P2P settlement: the API only reads confirmed USDT-TRC20 transfers.
MY_TRONLINK_PUBLIC_ADDRESS=TDg6Vo6pkvKLy1jPpD4LBSLa3EwrVEk2JP
TRON_USDT_CONTRACT=TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t
TRON_GRID_URL=https://api.trongrid.io
TRONSCAN_API_URL=https://apilist.tronscanapi.com
TRON_PRO_API_KEY=
TRON_MAX_LOOKBACK_MS=2592000000
TRON_REQUEST_TIMEOUT_MS=10000
USAGE_CPU_USD_PER_HOUR=0.12
USAGE_STORAGE_USD_PER_GB_MONTH=0.10
USAGE_SNAPSHOT_RETENTION_DAYS=180
ALLOW_PRIVATE_AGENT_ENDPOINTS=false

# Generate an age keypair. Keep its private identity off the VPS; put only the public recipient here.
BACKUP_AGE_RECIPIENT=age1replace_with_public_recipient
BACKUP_PATH=./backups
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=14
BACKUP_RETRY_SECONDS=300
BACKUP_HEALTH_WINDOW_MINUTES=1560

